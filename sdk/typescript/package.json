{
  "name": "@ami-protocol/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the AMI protocol — contract, provision and operate mobile identities for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "ami",
    "ami-protocol",
    "agent",
    "mobile-identity",
    "sim",
    "esim",
    "sms",
    "voice",
    "sip",
    "telephony",
    "agentic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gamino17/AMI",
    "directory": "sdk/typescript"
  },
  "homepage": "https://protocolami.com",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
