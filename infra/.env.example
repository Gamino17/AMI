# ============================================================================
#  AMI · Variables de entorno para el stack telco
#  Copia este archivo a `.env` y rellena los valores que el partner te entregue.
#  NO commitear `.env`.
# ============================================================================

# ---------- AMI backend ----------
AMI_API_KEY=cambia_esta_clave_a_un_secreto_largo
AMI_PUBLIC_URL=https://api.protocolami.com
AMI_REPO_URL=https://github.com/Gamino17/AMI
AMI_MCP_HTTP_URL=https://mcp.protocolami.com/mcp/
# Clave compartida con kannel y asterisk para los webhooks /v1/_telco/*.
# Larga, aleatoria, NO la default.
AMI_TELCO_INBOUND_KEY=cambia_esta_clave_telco_inbound
# mock = lifecycle simulado con Timers (v1). live = habla a kannel y asterisk.
AMI_TELCO_MODE=live

# ---------- Trunk SMPP del partner (lo entrega el operador) ----------
# Lo que recibes del partner cuando te da la licencia:
SMPP_HOST=smpp.partner.example
SMPP_PORT=2775
SMPP_SYSTEM_ID=ami_account
SMPP_PASSWORD=cambia_smpp_password
SMPP_SYSTEM_TYPE=
# Opcionales (algunos partners requieren TON/NPI específicos):
SMPP_SOURCE_TON=1
SMPP_SOURCE_NPI=1

# ---------- Kannel (gateway HTTP↔SMPP) ----------
# Cuenta sendsms HTTP que usa ami_api para mandarle SMS a Kannel.
# Solo tráfico interno del compose, no expuesto al exterior.
KANNEL_SENDSMS_USER=ami
KANNEL_SENDSMS_PASSWORD=cambia_kannel_sendsms_password

# ---------- Trunk SIP del partner (lo entrega el operador) ----------
SIP_TRUNK_HOST=sbc.partner.example
SIP_TRUNK_PORT=5060
SIP_TRUNK_USERNAME=ami_account
SIP_TRUNK_PASSWORD=cambia_sip_password

# IP pública del host donde corre Asterisk (importante para NAT/RTP).
# Si corre tras NAT, pon la IP pública del servidor; sin NAT, deja vacío.
EXTERNAL_IP=

# ---------- Asterisk ARI (interno) ----------
# Credenciales que ami_api usa para hablar a /ari del Asterisk.
ARI_USERNAME=ami_ari
ARI_PASSWORD=cambia_ari_password
